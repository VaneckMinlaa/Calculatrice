# ========================================
# Configuration Template - Credentials
# ========================================
# INSTRUCTIONS:
# 1. Copy this file and name it .env
# 2. Fill in your actual credentials below
# 3. The .env file will be gitignored for security
# ========================================

# PostgreSQL Database Configuration
POSTGRES_DB=calculatrice_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_PORT=5432

# Database Connection URL
DATABASE_URL=jdbc:postgresql://postgres-db:5432/calculatrice_db

# Application Ports
EUREKA_PORT=8761
GATEWAY_PORT=8080
ADDITION_PORT=8081
SUBTRACTION_PORT=8082
MULTIPLICATION_PORT=8083
DIVISION_PORT=8084
MODULO_PORT=8085

# Eureka Server URL
EUREKA_SERVER_URL=http://eureka-server:8761/eureka/

# JVM Options
JAVA_OPTS=-Xmx512m -Xms256m

