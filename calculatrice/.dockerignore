# ========================================
# Docker Ignore File
# ========================================
# Files and directories to exclude from Docker context
# This improves build performance and reduces image size
# ========================================

# Git
.git
.gitignore
.gitattributes

# Documentation
*.md
docs/
HELP.md
DEPLOYMENT.md
QUICK_START.md

# IDE
.idea/
.vscode/
.eclipse/
.settings/
*.iml
*.swp
*.swo
*~

# OS Files
.DS_Store
Thumbs.db
desktop.ini

# Build artifacts
target/
build/
out/
*.jar
*.war
*.ear
!.mvn/wrapper/maven-wrapper.jar

# Logs
*.log
logs/

# Environment files
.env
.env.*
!env.template

# Test files
**/test/
**/*Test.java
**/*Tests.java

# Scripts (already in container)
*.bat
*.sh

# Docker files in subdirectories
**/Dockerfile
**/docker-compose*.yml

# Maven wrapper (we use image's Maven)
.mvn/
mvnw
mvnw.cmd

# Node modules (if any)
node_modules/

# Temporary files
tmp/
temp/
*.tmp
*.bak
*.cache

